<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.inception</groupId>
    <artifactId>inception-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Inception Backend</name>

    <modules>
        <module>inception-auth</module>
        <module>inception-core</module>
        <module>inception-events</module>
        <module>inception-architecture</module>
        <module>inception-sedation</module>
        <module>inception-scenarios</module>
        <module>inception-monitoring</module>
        <module>inception-requests</module>
        <module>inception-api</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.inception</groupId>
                <artifactId>inception-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.inception</groupId>
                <artifactId>inception-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.inception</groupId>
                <artifactId>inception-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.inception</groupId>
                <artifactId>inception-architecture</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.inception</groupId>
                <artifactId>inception-sedation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.inception</groupId>
                <artifactId>inception-scenarios</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.inception</groupId>
                <artifactId>inception-monitoring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.inception</groupId>
                <artifactId>inception-requests</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
